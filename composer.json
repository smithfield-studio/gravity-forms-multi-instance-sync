{
    "name": "smithfield-studio/gravity-forms-multi-instance-sync",
    "description": "Place the same Gravity Form more than once on a page: it renders once and moves to whichever placement the visitor scrolls to.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "gravity-forms",
        "multiple-instances"
    ],
    "authors": [
        {
            "name": "Mike Sheppard",
            "email": "mike@smithfield.studio",
            "homepage": "https://smithfield.studio"
        }
    ],
    "support": {
        "issues": "https://github.com/smithfield-studio/gravity-forms-multi-instance-sync/issues",
        "source": "https://github.com/smithfield-studio/gravity-forms-multi-instance-sync"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "SmithfieldStudio\\GravityFormsMultiInstanceSync\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "scripts": {
        "format": "@php ./vendor/bin/mago format",
        "format:check": "@php ./vendor/bin/mago format --dry-run",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "@php ./vendor/bin/phpunit"
    },
    "scripts-aliases": {
        "phpstan": [
            "stan",
            "analyze",
            "analyse"
        ],
        "test": [
            "unit",
            "tests"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
