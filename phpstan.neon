includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 10 # max (PHPStan 2.x)
    # Match the composer platform pin, so PHPStan flags syntax newer than 8.2
    phpVersion:
        min: 80200
        max: 80299
    paths:
        - gravity-forms-multi-instance-sync.php
        - src/
        - templates/
